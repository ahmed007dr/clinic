# Copy this file to .env and fill in real values. Never commit .env.
#
# Nothing here is a real credential, and nothing here should become one. Every
# value is a placeholder — the previous version of this file carried the actual
# address and host that SEC-001 rotated away from after they leaked, which meant
# the template kept handing the compromised identity to whoever provisioned next.

# --- Database ---------------------------------------------------------------
# Local dev (the default when unset):  sqlite:///db.sqlite3
# Managed PostgreSQL (note the required sslmode):
#   postgres://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require
#
# The application connects as a role that is NEITHER SUPERUSER NOR BYPASSRLS.
# That is what makes the row-level security policies in tenants/migrations
# real — a superuser silently ignores every one of them. Migrations may need a
# separate, more privileged role; see INFRA-003.
DATABASE_URL=sqlite:///db.sqlite3

# --- Django -----------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=generate-a-new-one-do-not-reuse-any-published-value
DJANGO_DEBUG=False

# Comma-separated, no scheme. Must not be empty when DEBUG is False.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated, WITH scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- Transport security -----------------------------------------------------
# These default to secure whenever DJANGO_DEBUG is False, so a deployment gets
# them without setting anything. Override only for a reason.
#
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_SSL_REDIRECT=True
#
# Set this when TLS terminates at a load balancer or reverse proxy rather than
# at Django. Without it, SECURE_SSL_REDIRECT loops forever, because Django sees
# a plain-HTTP request and redirects it again. Only enable it when the proxy
# genuinely sets X-Forwarded-Proto and strips any client-supplied copy —
# otherwise a client can claim its own connection was secure.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
#
# HSTS is off by default on purpose: browsers cache it for max-age and will
# refuse plain HTTP to this domain for that whole period, ignoring later
# changes. Enable it once HTTPS is confirmed on the domain and every subdomain,
# and start small (3600 = one hour) before raising it to a year.
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False

# --- Email (SMTP) -----------------------------------------------------------
# Use SSL on 465, or TLS on 587 — one or the other, never both True.
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=set-this-in-the-real-env-file
DEFAULT_FROM_EMAIL=no-reply@example.com
