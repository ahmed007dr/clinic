# `npm run dev`. Every server address in the frontend comes from here —
# see src/lib/config.js. Override per machine in .env.development.local
# (git-ignored).

# Where Django runs. The dev server proxies everything outside /app to it, so
# the browser still sees one origin: no CORS, and the session cookie works.
VITE_BASE_URL=http://127.0.0.1:8000

# Where the router is mounted; must match the path api/spa.py serves.
VITE_APP_BASENAME=/app
