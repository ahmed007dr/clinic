# `npm run build`. Every server address in the frontend comes from here —
# see src/lib/config.js.

# Where the browser reaches Django. EMPTY means the same origin that served
# the page, which is the normal deployment: Django serves /app/ itself.
# Setting another origin (https://api.example.com) also requires CORS and
# cross-site session/CSRF cookies on the Django side — without them every
# request fails.
VITE_BASE_URL=

# Where the router is mounted; must match the path api/spa.py serves.
VITE_APP_BASENAME=/app
