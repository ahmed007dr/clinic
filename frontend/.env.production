# `npm run build`. Every server address in the frontend comes from here —
# see src/lib/config.js.

# Where the browser reaches Django. Keep it equal to PRIMARY_DOMAIN in
# project/config.py. Django serves /app/ itself, so this is the same origin as
# the page and no CORS is involved. (Leaving it EMPTY also works and makes the
# build host-independent; a different origin would need CORS and cross-site
# cookies on the Django side.)
VITE_BASE_URL=https://dr-clinic.xpro24.com

# Where the router is mounted; must match the path api/spa.py serves.
VITE_APP_BASENAME=/app
